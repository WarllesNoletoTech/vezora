generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id           String   @id @default(uuid()) @map("_id")
  name         String
  phone        String?  // null em contas antigas; exige atualizacao no proximo acesso
  role         UserRole? // null = LOJISTA legado; somente CLI promove SUPERADMIN
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  tenant       Tenant?
}

model Tenant {
  id             String         @id @default(uuid()) @map("_id")
  ownerId        String         @unique
  owner          User           @relation(fields: [ownerId], references: [id])
  name           String
  slug           String         @unique
  bio            String         @default("")
  whatsapp       String         @default("")
  instagram      String         @default("")
  address        String         @default("")
  logoUrl        String         @default("")
  coverUrl       String         @default("")
  onboardingCompletedAt DateTime? // Guia inicial concluido, persistido para outros aparelhos
  primaryColor   String         @default("#8F5176")
  secondaryColor String         @default("#211925")
  timezone       String         @default("America/Sao_Paulo")
  // Nulo apenas para contas antigas: atualizar no próximo login.
  businessType   BusinessType?
  trialStartsAt  DateTime?
  trialDays      Int? // snapshot do periodo de teste no cadastro; null legado equivale a 3
  trialExtensionDays Int? // nulo em contas anteriores a v0.6
  suspendedAt    DateTime?
  suspensionReason String?
  subscriptionEndsAt DateTime?
  subscriptionPayments SubscriptionPayment[]
  cardSubscription CardSubscription?
  createdAt      DateTime       @default(now())
  services       Service[]
  professionals  Professional[]
  bookings       Booking[]
  bookingReceipts BookingReceipt[]
  paymentAccount PaymentAccount?
  oauthStates    OAuthState[]
}

model Service {
  id           String      @id @default(uuid()) @map("_id")
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String      @default("")
  priceCents   Int
  durationMin  Int
  depositMode  DepositMode @default(NONE)
  depositValue Int         @default(0) // percentual inteiro ou centavos, conforme modo
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  bookings     Booking[]
  @@index([tenantId, active])
}

enum DepositMode {
  NONE
  PERCENT
  FIXED
}

model Professional {
  id        String    @id @default(uuid()) @map("_id")
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  photoUrl  String    @default("")
  active    Boolean   @default(true)
  // chaves 0..6 (domingo..sábado), valores ["09:00","18:00"] ou null
  schedule  Json
  bookings  Booking[]
  bookingRevision Int @default(0) // Atualizado transacionalmente: exclusão mútua por profissional.
  role            ProfessionalRole @default(EMPLOYEE)
  salaryEnabled   Boolean @default(false)
  salaryCents     Int @default(0) // salário mensal contratado (não significa que foi pago)
  commissionMode  CommissionMode @default(NONE)
  commissionValue Int @default(0) // percentual inteiro ou centavos por atendimento
  @@index([tenantId, active])
}

model Booking {
  id              String         @id @default(uuid()) @map("_id")
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service        @relation(fields: [serviceId], references: [id])
  professionalId  String
  professional    Professional   @relation(fields: [professionalId], references: [id])
  clientName      String
  clientPhone     String
  startAt         DateTime
  endAt           DateTime
  status          BookingStatus  @default(CONFIRMED)
  expiresAt       DateTime?
  depositCents    Int            @default(0)
  checkoutUrl     String?
  preferenceId    String?
  mpPaymentId     String?
  paymentStatus   String?
  servicePriceCents Int? // preço congelado na reserva; null em dados anteriores
  commissionCents Int? // comissão congelada na reserva; null em dados anteriores
  reminderNotifiedAt DateTime? // OneSignal: lembrete 1h antes (evita disparos repetidos)
  depositPaidAt   DateTime?
  receiptRevision Int @default(0) // protege contra recebimentos simultâneos
  receipts        BookingReceipt[]
  createdAt       DateTime       @default(now())
  @@index([professionalId, startAt, endAt, status])
  @@index([tenantId, startAt])
  @@index([mpPaymentId])
}

// Comissões são estimativas contratuais dos serviços concluídos.
enum ProfessionalRole {
  OWNER
  EMPLOYEE
  CONTRACTOR
}

enum CommissionMode {
  NONE
  PERCENT
  FIXED
}

enum ReceiptMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  OTHER
}

// Lançamentos manuais imutáveis; estornos registram motivo sem apagar histórico.
model BookingReceipt {
  id           String @id @default(uuid()) @map("_id")
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingId    String
  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountCents  Int
  method       ReceiptMethod
  note         String @default("")
  recordedById String
  createdAt    DateTime @default(now())
  voidedAt     DateTime?
  voidReason   String?
  @@index([tenantId, createdAt])
  @@index([bookingId, createdAt])
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
  NEEDS_REVIEW
}

model PaymentAccount {
  id               String   @id @default(uuid()) @map("_id")
  tenantId         String   @unique
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerUserId     String
  encryptedToken   String
  encryptedRefresh String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OAuthState {
  id                String    @id @default(uuid()) @map("_id")
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stateHash         String    @unique
  encryptedVerifier String
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
}

// Categorias comuns no Brasil — não limitamos o sistema apenas a salões.
enum BusinessType {
  BARBEARIA
  CABELEIREIRO
  SALAO_BELEZA
  NAIL_DESIGNER
  MANICURE_PEDICURE
  LASH_DESIGNER
  SOBRANCELHAS
  ESTETICA
  MAQUIAGEM
  DEPILACAO
  MASSOTERAPIA
  PODOLOGIA
  OUTROS
}

model SubscriptionPayment {
  id             String   @id @default(uuid()) @map("_id")
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amountCents    Int
  status         String   @default("PENDING")
  paymentMethod  String   @default("PIX") // PIX ou CARD
  mpPaymentId    String?
  qrCode         String   @default("")
  qrCodeBase64   String   @default("")
  ticketUrl      String   @default("")
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  paidAt         DateTime?
  @@index([tenantId, status, createdAt])
  @@index([mpPaymentId])
}


// SUPERADMIN nunca e escolhido pelo cadastro publico; promovido somente pelo CLI seguro.
enum UserRole {
  LOJISTA
  SUPERADMIN
}

// Registro unico de configuracoes comerciais da plataforma.
model PlatformSettings {
  id                String   @id @default("global") @map("_id")
  monthlyPriceCents Int      @default(0)
  trialDays         Int      @default(3) // aplicado aos novos cadastros
  updatedAt         DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(uuid()) @map("_id")
  actorId   String
  tenantId  String?
  action    String
  details   String   @default("")
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([tenantId, createdAt])
}

// Autorizacao recorrente de cartao via checkout hospedado do Mercado Pago.
// O Vezora nunca armazena dados brutos de cartao.
model CardSubscription {
  id            String   @id @default(uuid()) @map("_id")
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preapprovalId String   @unique @default(uuid())
  checkoutUrl   String   @default("")
  status        String   @default("CREATING")
  amountCents   Int
  payerEmail    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([tenantId, createdAt])
}

// Idempotencia real de renovacoes no cartao: um pagamento so gera 30 dias uma vez.
model CardSubscriptionCharge {
  id          String   @id @default(uuid()) @map("_id")
  tenantId    String
  preapprovalId String
  mpPaymentId String @unique
  amountCents Int
  paidAt      DateTime @default(now())
  @@index([tenantId, paidAt])
}
