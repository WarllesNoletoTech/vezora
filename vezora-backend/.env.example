# Banco MongoDB Atlas: URL completa COM nome do banco /vezora
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/vezora?retryWrites=true&w=majority
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
# Opcional antes do Mercado Pago. Necessária para pagamentos/webhooks em produção.
API_PUBLIC_URL=http://localhost:4000
JWT_SECRET=COLOQUE_UMA_CHAVE_ALEATORIA_DE_32_OU_MAIS_CARACTERES
TOKEN_ENCRYPTION_KEY=COLOQUE_64_CARACTERES_HEXADECIMAIS_ALEATORIOS
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
MP_WEBHOOK_SECRET=

# Defina o valor ANTES de cobrar: em centavos (ex.: 3990 = R$ 39,90)
VEZORA_MONTHLY_PRICE_CENTS=0
# Credencial da SUA conta Vezora para assinaturas, diferente de MP_CLIENT_ID dos lojistas
VEZORA_MP_ACCESS_TOKEN=
VEZORA_MP_WEBHOOK_SECRET=
# Opcional: protege contra pagamentos destinados a outra conta
VEZORA_MP_COLLECTOR_ID=
